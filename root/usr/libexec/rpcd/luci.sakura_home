#!/usr/bin/ucode
// 樱花首页数据后端 (rpcd exec 协议)
'use strict';

import { readfile, writefile } from 'fs';
import { connect as ubus_connect } from 'ubus';
import { cursor as uci_cursor } from 'uci';

function rf(p) { try { return readfile(p); } catch (e) { return null; } }
function wf(p, s) { try { writefile(p, s); } catch (e) { } }
function sstr(s) { if (s == null) return ''; return '' + s; }
function mytrim(s) { return replace(sstr(s), /^\s+|\s+$/g, ''); }
function num(s) { let n = +s; if (n != n) return 0; return n; }
function numlist(s) {
	let out = [];
	let r = match(s, /\d+/g);
	if (r) for (let m in r) {
		let v = (type(m) == 'array') ? m[0] : m;
		let n = +v;
		if (n == n) push(out, n);
	}
	return out;
}
function ex(cmd) { try { let fd = popen(cmd); let s = fd.read('all'); fd.close(); return s; } catch (e) { return ''; } }
function fmt_size(kb) {
	let b = kb * 1024;
	if (b >= 1073741824) return sprintf('%.1f GB', b / 1073741824);
	if (b >= 1048576) return sprintf('%.0f MB', b / 1048576);
	return sprintf('%.0f KB', b / 1024);
}
function fmt_rate(b) {
	if (b >= 1048576) return sprintf('%.2f MB/s', b / 1048576);
	if (b >= 1024) return sprintf('%.2f KB/s', b / 1024);
	return sprintf('%.0f B/s', b);
}
/* ---------------------------------------------------------------
 * Bandix 每设备 日/周/月 流量（读 shell 脚本生成的原始 JSON ✓）
 * 数据源：/tmp/sakura_bandix/  （由 sakura-bandix-fetch 每分钟生成）
 * 说明：ucode 沙箱禁 popen ✗ → 只能读文件 ✓；JSON 解析用 json() ✓
 * ---------------------------------------------------------------*/
let BANDIX_DIR = '/tmp/sakura_bandix';
let BANDIX_TZ  = 28800;   /* UTC+8 */

function bandix_enabled() {
	let c = rf('/etc/config/sakura') || '';
	let ls = split(c, '
');
	let inSec = false;
	for (let i = 0; i < length(ls); i++) {
		let t = trim(ls[i]);
		if (match(t, /^config\s+bandix/)) { inSec = true; continue; }
		if (match(t, /^config\s+/)) { inSec = false; continue; }
		if (inSec) {
			let m = match(t, /^option\s+enabled\s+['"]?([^'"]+)['"]?/);
			if (m) return (m[1] == '1' || m[1] == 'on' || m[1] == 'true');
		}
	}
	return false;
}

function bandix_set_enabled(on) {
	let c = rf('/etc/config/sakura') || '';
	let ls = split(c, '
');
	let out = [];
	let inSec = false, hasSec = false;
	let val = on ? '1' : '0';
	for (let i = 0; i < length(ls); i++) {
		let ln = ls[i];
		let t = trim(ln);
		if (match(t, /^config\s+bandix/)) {
			hasSec = true; inSec = true;
			push(out, ln);
			push(out, sprintf("	option enabled '%s'", val));
			continue;
		}
		if (inSec && match(t, /^config\s+/)) inSec = false;
		if (inSec && match(t, /^option\s+enabled\s/)) continue;   /* 丢弃旧值 ✓ */
		push(out, ln);
	}
	if (!hasSec) {
		push(out, '');
		push(out, 'config bandix');
		push(out, sprintf("	option enabled '%s'", val));
	}
	wf('/etc/config/sakura', join('
', out));
	/* 同步 uci 内部状态（尽力而为 ✓）*/
	try {
		let u = ubus_connect();
		u.call('uci', 'set', { config: 'sakura', section: 'bandix', values: { enabled: val } });
		u.call('uci', 'commit', { config: 'sakura' });
		u.disconnect();
	} catch (e) { }
	return true;
}

/* 计算 [st,en] 与 [edge, now_ms] 的重叠比例（0~1）✓
 * ★ 必须定义在调用者之前：ucode 不支持前向引用 ✗ */
function bandix_overlap(st, en, edge, now_ms) {
	if (en <= edge || st >= now_ms) return 0;
	/* ★ 进行中的桶：数据只累积到"现在"，分母必须用 now-st；
	 *   若用整天 en-st 会【低估】(实测低估约 38%) ✗ */
	let span = (now_ms < en) ? (now_ms - st) : (en - st);
	if (span <= 0) return 0;
	let lo = (st > edge) ? st : edge;
	if (lo >= now_ms) return 0;
	/* ★ 必须乘 1.0：ucode 整数除法会截断成 0 ✗ */
	return (now_ms - lo) * 1.0 / span;
}

/* 汇总某设备某网络的增量数据 → { day, week, month }（单位：字节）
 * ★ 全部用【滚动窗口】比较，彻底避开 bandix 用 UTC 日边界、
 *   而系统用 CST 导致的 8 小时错位问题 ✓
 *   同时用 inc 的 [start,end] 区间与窗口求交，按比例折算，
 *   避免"跨窗口的那一条整天数据"被整条计入或整条丢弃 ✓ */
function bandix_sum_dev(mac, net, day_ms, week_ms, mon_ms) {
	let res = { day_rx: 0, day_tx: 0, week_rx: 0, week_tx: 0, mon_rx: 0, mon_tx: 0 };
	let f = rf(sprintf('%s/%s_%s.json', BANDIX_DIR, net, mac));
	if (!f) return res;
	let j = null;
	try { j = json(f); } catch (e) { return res; }
	if (!j || !j.data || !j.data.inc) return res;
	/* wan 网络用 w_* 字段，lan 网络用 l_* 字段 ✓ */
	let pf = (net == 'lan') ? 'l_' : 'w_';
	let inc = j.data.inc;
	for (let k = 0; k < length(inc); k++) {
		let it = inc[k];
		let st = num(it.start), en = num(it.end);
		let rx = num(it[pf + 'rx_b']), tx = num(it[pf + 'tx_b']);
		if (rx == 0 && tx == 0) continue;
		if (en <= st) { en = st + 86400000; }   /* 兜底：缺 end 时按 1 天算 ✓ */
		let span = en - st;
		/* 当前时刻（本设备文件内自取，避免再多传参数 ✓） */
		let now_ms = time() * 1000;
		/* 与各窗口 [edge, now] 的重叠比例 ✓ */
		let f_mon  = bandix_overlap(st, en, mon_ms,  now_ms);
		let f_week = bandix_overlap(st, en, week_ms, now_ms);
		let f_day  = bandix_overlap(st, en, day_ms,  now_ms);
		res.mon_rx  += int(rx * f_mon);  res.mon_tx  += int(tx * f_mon);
		res.week_rx += int(rx * f_week); res.week_tx += int(tx * f_week);
		res.day_rx  += int(rx * f_day);  res.day_tx  += int(tx * f_day);
	}
	return res;
}

/* 探测 bandix 环境 ✓
 * ucode 沙箱禁 popen → 全部改用【读文件】判断，不依赖任何外部命令 */
function bandix_probe() {
	let r = { installed: false, api_up: false, fetch: false, conf: false, bin: false };
	if (rf('/usr/bin/sakura-bandix-fetch')) r.fetch = true;
	if (rf('/etc/config/bandix')) r.conf = true;
	if (rf('/usr/bin/bandix') || rf('/usr/sbin/bandix')) r.bin = true;
	try {
		let stt = rf('/usr/lib/opkg/status');
		if (stt && match(stt, /Package:\s*bandix\b/)) r.bin = true;
	} catch (e) { }
	/* API 是否在监听 8686(0x21EE) ✓ 读 /proc/net/tcp，杜绝 popen */
	let tcp = sstr(rf('/proc/net/tcp')) + sstr(rf('/proc/net/tcp6'));
	if (match(tcp, /:21EE\s/) || match(tcp, /:21ee\s/)) r.api_up = true;
	/* 三者任一即视为"装过"（用户可能只用 API 不用脚本）*/
	r.installed = (r.conf || r.bin || r.fetch);
	return r;
}

function get_bandix_data() {
	let now = time();
	let pr = bandix_probe();
	let ts = num(trim(rf(sprintf('%s/ts', BANDIX_DIR)) || '0'));
	let o = {
		ok: false, enabled: bandix_enabled(),
		installed: pr.installed, api_up: pr.api_up, has_fetch: pr.fetch,
		/* state: ok | stale | idle(装了没数据) | absent(根本没装) */
		state: pr.installed ? 'idle' : 'absent',
		ts: ts, age: (ts > 0) ? (now - ts) : -1,
		devices: []
	};

	let ds = rf(sprintf('%s/devices.json', BANDIX_DIR));
	if (!ds) return o;
	let dj = null;
	try { dj = json(ds); } catch (e) { return o; }
	if (!dj || !dj.data || !dj.data.d) return o;
	o.ok = true;
	o.state = (ts > 0 && (now - ts) > 180) ? 'stale' : 'ok';

	/* ★ 滚动窗口（近 24 小时 / 近 7 天 / 近 30 天）
	 *   不用"自然日/周/月"，彻底避开 UTC↔CST 边界错位 ✓ */
	let now_ms  = now * 1000;
	let day_ms  = now_ms - 86400 * 1000;
	let week_ms = now_ms - 7 * 86400 * 1000;
	let mon_ms  = now_ms - 30 * 86400 * 1000;

	let devs = dj.data.d;
	for (let i = 0; i < length(devs); i++) {
		let d = devs[i];
		let mac = sstr(d.mac);
		if (length(mac) == 0) continue;
		let w = bandix_sum_dev(mac, 'wan', day_ms, week_ms, mon_ms);
		/* 展示以 WAN 为主（外网流量 = 通常说的"用了多少流量"✓）*/
		let rec = {
			ip: d.ip4, mac: mac, host: sstr(d.host),
			day:   { rx: w.day_rx,   tx: w.day_tx,   total: w.day_rx + w.day_tx },
			week:  { rx: w.week_rx,  tx: w.week_tx,  total: w.week_rx + w.week_tx },
			month: { rx: w.mon_rx,   tx: w.mon_tx,   total: w.mon_rx + w.mon_tx }
		};
		rec.day.rx_s   = fmt_size(rec.day.rx / 1024);
		rec.day.tx_s   = fmt_size(rec.day.tx / 1024);
		rec.day.total_s = fmt_size(rec.day.total / 1024);
		rec.week.rx_s  = fmt_size(rec.week.rx / 1024);
		rec.week.tx_s  = fmt_size(rec.week.tx / 1024);
		rec.week.total_s = fmt_size(rec.week.total / 1024);
		rec.month.rx_s = fmt_size(rec.month.rx / 1024);
		rec.month.tx_s = fmt_size(rec.month.tx / 1024);
		rec.month.total_s = fmt_size(rec.month.total / 1024);
		push(o.devices, rec);
	}
	return o;
}


/* 磁盘使用情况（读 cron 生成的缓存 ✓）*/
function get_disks() {
	let out = [];
	let raw = rf('/tmp/sakura_disks.cache') || '';
	let lines = split(raw, '\n');
	for (let i = 0; i < length(lines); i++) {
		let ln = lines[i];
		if (length(ln) < 5) continue;
		let p = split(ln, '|');
		if (length(p) < 6) continue;
		let total = +p[2], used = +p[3], avail = +p[4];
		if (total <= 0) continue;
		push(out, {
			mount: p[0], dev: p[1],
			total: total, used: used, avail: avail,
			pct: (used * 100.0 / total),
			pct_s: p[5],
			total_s: fmt_size(total),
			used_s: fmt_size(used),
			avail_s: fmt_size(avail)
		});
	}
	return out;
}
/* 在线设备（DHCP租约 + ARP表 ✓ 纯读文件 ✗ 不用 popen ✓）*/
function get_devices() {
	let out = [];
	let names = {};
	let lf = rf('/tmp/dhcp.leases') || '';
	let lls = split(lf, '\n');
	for (let i = 0; i < length(lls); i++) {
		let p = match(lls[i], /^\S+\s+(\S+)\s+(\S+)\s+(\S+)/);
		if (p && p[3] && p[3] != '*') names[p[1]] = p[3];
	}
	let arp = rf('/proc/net/arp') || '';
	let als = split(arp, '\n');
	for (let i = 1; i < length(als); i++) {
		let p = match(als[i], /^(\S+)\s+0x1\s+0x(\S+)\s+(\S+)/);
		if (!p) continue;
		let ip = p[1], flags = p[2], mac = p[3];
		if (mac == '00:00:00:00:00:00' || length(mac) < 11) continue;
		push(out, {
			ip: ip, mac: mac,
			name: names[mac] || '',
			online: (flags == '2')
		});
	}
	return out;
}

/* 流量统计（读 cron 累计的缓存 ✓）*/
function get_traffic() {
	let c = rf('/tmp/sakura_traffic.cache') || '';
	let o = {};
	let ls = split(c, '\n');
	for (let i = 0; i < length(ls); i++) {
		let p = match(ls[i], /^([A-Z_]+)=(.*)$/);
		if (p) o[p[1]] = p[2];
	}
	let d_rx = num(o.D_RX), d_tx = num(o.D_TX);
	let m_rx = num(o.M_RX), m_tx = num(o.M_TX);
	let t_rx = num(o.T_RX), t_tx = num(o.T_TX);
	return {
		ok: length(c) > 0,
		dev: o.DEV || '',
		date: o.L_DATE || '',
		day_rx: d_rx, day_tx: d_tx, day_total: d_rx + d_tx,
		mon_rx: m_rx, mon_tx: m_tx, mon_total: m_rx + m_tx,
		tot_rx: t_rx, tot_tx: t_tx, tot_total: t_rx + t_tx,
		day_rx_s: fmt_size(d_rx / 1024), day_tx_s: fmt_size(d_tx / 1024),
		day_total_s: fmt_size((d_rx + d_tx) / 1024),
		mon_rx_s: fmt_size(m_rx / 1024), mon_tx_s: fmt_size(m_tx / 1024),
		mon_total_s: fmt_size((m_rx + m_tx) / 1024),
		tot_total_s: fmt_size((t_rx + t_tx) / 1024),
		upd: o.L_TS ? sprintf('%.0f', time() - num(o.L_TS)) : ''
	};
}

function cpu_sample() {
	let s = rf('/proc/stat');
	if (!s) return null;
	let m = match(s, /^cpu\s+(\d+)\s+(\d+)\s+(\d+)\s+(\d+)/);
	if (!m) return null;
	return { busy: +m[1] + +m[2] + +m[3], idle: +m[4] };
}

function get_status() {
	let out = {};
	let now = time();

	let c = cpu_sample();
	let cpu_pct = 0;
	if (c) {
		let pc = numlist(rf('/tmp/sakura_cpu.state') || '');
		let pt = numlist(rf('/tmp/sakura_cpu.time') || '');
		let last_t = (length(pt) >= 1) ? +pt[0] : 0;
		/* ★ 采样间隔必须 >= 2 秒，否则算出来是垃圾值（比如间隔几毫秒会出现 1/7=14.29%）
		   间隔不够时，沿用上一次的计算结果 */
		if (length(pc) >= 2 && last_t > 0 && (now - last_t) >= 2) {
			let db = c.busy - pc[0], di = c.idle - pc[1];
			if (db + di > 0) {
				cpu_pct = db * 100.0 / (db + di);
				wf('/tmp/sakura_cpu.state', sprintf('%.0f %.0f', c.busy, c.idle));
				wf('/tmp/sakura_cpu.time', sprintf('%d', now));
				wf('/tmp/sakura_cpu.last', sprintf('%.2f', cpu_pct));
			}
		} else {
			let lp = numlist(rf('/tmp/sakura_cpu.last') || '');
			if (length(lp) >= 1) cpu_pct = lp[0];
			if (last_t == 0) {
				wf('/tmp/sakura_cpu.state', sprintf('%.0f %.0f', c.busy, c.idle));
				wf('/tmp/sakura_cpu.time', sprintf('%d', now));
			}
		}
	}
	let ci = rf('/proc/cpuinfo') || '';
	let cores = 0, mhz = null;
	for (let line in split(ci, '\n')) {
		if (match(line, /^processor\s*:/)) cores++;
		let mm = match(line, /cpu MHz\s*:\s*([0-9.]+)/);
		if (mm && !mhz) mhz = +mm[1];
	}
	out.cpu_pct = cpu_pct;
	out.cpu_cores = cores;
	out.cpu_mhz = mhz;

	let mi = rf('/proc/meminfo') || '';
	let mtot = num((match(mi, /MemTotal:\s*(\d+)/) || [0, 0])[1]);
	let mav = num((match(mi, /MemAvailable:\s*(\d+)/) || [0, 0])[1]);
	if (!mav) mav = num((match(mi, /MemFree:\s*(\d+)/) || [0, 0])[1]);
	let mused = mtot - mav;
	out.mem_total = mtot;
	out.mem_used = mused;
	out.mem_pct = mtot > 0 ? (mused * 100.0 / mtot) : 0;
	out.mem_used_s = fmt_size(mused);
	out.mem_total_s = fmt_size(mtot);

	let temp = null;
	for (let p in [ '/sys/class/thermal/thermal_zone0/temp', '/sys/class/thermal/thermal_zone1/temp' ]) {
		let v = num(rf(p));
		if (v > 1000) { temp = v / 1000; break; }
	}
	if (temp == null) {
		for (let i = 0; i < 12; i++) {
			let v = num(rf(sprintf('/sys/class/hwmon/hwmon%d/temp1_input', i)));
			if (v > 1000 && v < 150000) { temp = v / 1000; break; }
		}
	}
	out.temp = temp;
	out.temp_pct = (temp != null) ? (((temp * 100.0 / 85) > 100) ? 100 : (temp * 100.0 / 85)) : 0;
	out.temp_s = temp != null ? sprintf('%.0f℃', temp) : '—';

	/* ★ 实时网速：只统计 WAN 接口，绝不能把所有接口相加
	   为什么：下载时同一份数据会在 WAN 上算一次 RX，
	   又在 LAN 物理口和 br-lan 桥接层各算一次 TX，
	   相加会让"上传"虚高 2 倍，看起来上传比下载还快。
	   只读 WAN：RX = 下载，TX = 上传，方向才正确。 */
	let wanDev = '';
	let wc0 = rf('/tmp/sakura_traffic.cache') || '';
	let wm0 = match(wc0, /(^|\n)DEV=(\S+)/);      /* ucode 不支持 (?: 非捕获组，用捕获组 */
	if (wm0) wanDev = wm0[2];
	if (!wanDev) {
		/* 兜底：从默认路由找出口接口 ✓ 不依赖脚本写缓存 */
		let rtb = rf('/proc/net/route') || '';
		for (let line in split(rtb, '\n')) {
			let rm = match(line, /^(\S+)\s+00000000/);
			if (rm) { wanDev = rm[1]; break; }
		}
	}
	let nd = rf('/proc/net/dev') || '';
	let rx = 0, tx = 0;
	for (let line in split(nd, '\n')) {
		let m2 = match(line, /^\s*([^:]+):\s*(.+)$/);
		if (!m2) continue;
		let nm2 = mytrim(m2[1]);
		if (wanDev ? (nm2 != wanDev) : /^(lo|br-|docker|veth|tun|tap|wlan|6in4|sit|bond)/.test(nm2)) continue;
		let ns = numlist(m2[2]);
		if (length(ns) >= 9) { rx += ns[0]; tx += ns[8]; }
	}
	let dl = 0, ul = 0;
	let pm = numlist(rf('/tmp/sakura_net.state') || '');
	if (length(pm) >= 3 && pm[0] > 0 && now > pm[0] && (rx - pm[1]) >= 0 && (tx - pm[2]) >= 0) {
		let dt = now - pm[0];
		if (dt > 0) { dl = (rx - pm[1]) * 1.0 / dt; ul = (tx - pm[2]) * 1.0 / dt; }
	}
	wf('/tmp/sakura_net.state', sprintf('%.0f %.0f %.0f', now, rx, tx));

	let hist = [];
	let hraw = rf('/tmp/sakura_net.hist');
	if (hraw) {
		let hm = numlist(hraw);
		for (let i = 0; i < length(hm); i++)
			if (hm[i] >= 0) push(hist, hm[i]);
	}
	if (dl != dl) dl = 0;
	if (ul != ul) ul = 0;
	push(hist, dl);
	while (length(hist) > 40) shift(hist);
	let parts = [];
	for (let v in hist) push(parts, sprintf('%.3f', v));
	wf('/tmp/sakura_net.hist', join(' ', parts));

	/* 上传历史（用于双折线 ✓）*/
	let histu = [];
	let hrawu = rf('/tmp/sakura_net_ul.hist');
	if (hrawu) { let hu = numlist(hrawu); for (let i = 0; i < length(hu); i++) if (hu[i] >= 0) push(histu, hu[i]); }
	push(histu, ul);
	while (length(histu) > 40) shift(histu);
	let partsu = [];
	for (let v in histu) push(partsu, sprintf('%.3f', v));
	wf('/tmp/sakura_net_ul.hist', join(' ', partsu));
	out.net_ul_max = 1;
	for (let v in histu) if (v > out.net_ul_max) out.net_ul_max = v;

	out.net_dl = dl;
	out.net_ul = ul;
	out.net_dl_s = fmt_rate(dl);
	out.net_ul_s = fmt_rate(ul);

	/* 双折线共用同一量程 ✓ */
	let maxv = 1;
	for (let v in hist) if (v > maxv) maxv = v;
	for (let v in histu) if (v > maxv) maxv = v;
	let n = length(hist);
	let nu = length(histu);
	let pts = [], ptsu = [];
	for (let i = 0; i < n; i++) {
		let yy = 30 - (hist[i] * 26.0 / maxv);
		if (yy != yy) yy = 30;
		push(pts, sprintf('%.1f,%.1f', (n <= 1) ? 0 : (i * 100.0 / (n - 1)), yy));
	}
	for (let i = 0; i < nu; i++) {
		let yy = 30 - (histu[i] * 26.0 / maxv);
		if (yy != yy) yy = 30;
		push(ptsu, sprintf('%.1f,%.1f', (nu <= 1) ? 0 : (i * 100.0 / (nu - 1)), yy));
	}
	out.poly = join(' ', pts);
	out.poly_ul = join(' ', ptsu);

	out.hostname = mytrim(rf('/proc/sys/kernel/hostname') || 'OpenWrt');
	out.model = mytrim(rf('/tmp/sysinfo/model') || 'Generic x86/64');
	let fwm = match(rf('/etc/openwrt_release') || '', /DISTRIB_DESCRIPTION='([^']+)'/);
	out.firmware = fwm ? fwm[1] : 'OpenWrt';
	let up = num((match(rf('/proc/uptime') || '0', /^(\d+)/) || [0, 0])[1]);
	out.uptime = up;
	out.uptime_s = sprintf('%d 天 %d 时 %d 分', (up - (up % 86400)) / 86400, ((up % 86400) - (up % 3600)) / 3600, ((up % 3600) - (up % 60)) / 60);

	let ifs = [];
	try {
		let conn = ubus_connect();
		let r = conn.call('network.interface', 'dump');
		if (r && r.interface) {
			for (let it in r.interface) {
				let nm = it.interface || '';
				let label = null;
				if (match(nm, /^wan/)) label = 'WAN';
				else if (match(nm, /^lan/)) label = 'LAN';
				else if (match(nm, /^(wlan|wwan|ra\d)/)) label = 'WLAN';
				else if (match(nm, /(wg|vpn|tun)/)) label = 'VPN';
				let v4 = null, v6 = null, gw = null, dnss = [];
				let a4 = it['ipv4-address'];
				if (a4 && length(a4) > 0) {
					let a0 = a4[0];
					if (a0 && a0.address) {
						v4 = '' + a0.address;
						if (a0.mask != null) v4 = sprintf('%s/%d', v4, a0.mask);
					}
				}
				let a6 = it['ipv6-address'];
				if (a6) {
					for (let i = 0; i < length(a6); i++) {
						let ad = (a6[i] && a6[i].address) ? ('' + a6[i].address) : '';
						if (length(ad) > 0 && !match(ad, /^fe80/)) { v6 = ad; break; }
					}
				}
				let rts = it.route;
				if (rts) {
					for (let i = 0; i < length(rts); i++) {
						if (rts[i] && rts[i].nexthop && gw == null) gw = '' + rts[i].nexthop;
					}
				}
				let ds = it['dns-server'];
				if (ds) {
					for (let i = 0; i < length(ds); i++) {
						if (ds[i] && !match('' + ds[i], /^(127\.|::1$)/)) push(dnss, '' + ds[i]);
					}
				}
				push(ifs, { name: nm, label: label, up: it.up === true, proto: it.proto || '',
					v4: v4, v6: v6, gw: gw, dns: dnss, uptime: (it.uptime || 0) });
			}
		}
		if (conn) conn.disconnect();
	} catch (e) { }
	out.interfaces = ifs;

	/* 网络连接信息（WAN 优先 ✓）*/
	let wan = null;
	for (let i = 0; i < length(ifs); i++) {
		if (ifs[i].label == 'WAN' && ifs[i].up) { wan = ifs[i]; break; }
	}
	if (wan == null) {
		for (let i = 0; i < length(ifs); i++) {
			if (ifs[i].up && ifs[i].v4) { wan = ifs[i]; break; }
		}
	}
	out.wan4 = wan ? (wan.v4 || '') : '';
	/* ★ WAN 的 IPv6 地址：不能跟着 wan 走
	   坑：wan 和 wan6 都满足 /^wan/，label 都是 'WAN'，
	   而循环里先找到的是 IPv4 的 wan —— 它的 ipv6-address 是空数组，
	   所以 out.wan6 恒为空，卡片就显示"未启用"（但徽章用 wan6_on 又是"已启用"）。
	   正确做法：在所有 up 且带【公网级】IPv6 的 WAN 接口里挑。 */
	let wan6 = '';
	for (let i = 0; i < length(ifs); i++) {
		if (!ifs[i].up) continue;
		let v6v = ifs[i].v6 || '';
		if (length(v6v) == 0) continue;
		if (match(v6v, /^fe80/i)) continue;      /* 链路本地 */
		if (match(v6v, /^f[cd]/i)) continue;     /* ULA（内网地址，不是公网）*/
		if (ifs[i].label == 'WAN' || match(ifs[i].name, /^wan/)) { wan6 = v6v; break; }
	}
	out.wan6 = wan6;
	out.wan_gw = wan ? (wan.gw || '') : '';
	let dnsall = [];
	if (wan && wan.dns) {
		for (let i = 0; i < length(wan.dns); i++) push(dnsall, wan.dns[i]);
	}
	if (length(dnsall) == 0) {
		let rc = rf('/tmp/resolv.conf.d/resolv.conf.auto') || rf('/etc/resolv.conf') || '';
		let lines = split(rc, '\n');
		for (let i = 0; i < length(lines); i++) {
			let m = match(lines[i], /^nameserver\s+(\S+)/);
			if (m && length(m) > 1 && !match(m[1], /^(127\.|::1$)/)) push(dnsall, m[1]);
		}
	}
	out.wan_dns = join(' / ', dnsall);
	out.wan_if = wan ? (wan.label || wan.name) : '';

	/* 公网 IP（逐行解析天气缓存 ✓ 避免复杂正则 ✗）*/
	let wc = rf('/tmp/sakura_weather.cache') || '';
	let wo = {};
	let wlines = split(wc, '\n');
	for (let i = 0; i < length(wlines); i++) {
		let p = match(wlines[i], /^([a-z_]+)=(.*)$/);
		if (p) wo[p[1]] = p[2];
	}
	out.pub_ip = wo.ip || '';
	out.pub_loc = (wo.region || '') + ((wo.region && wo.city) ? ' · ' : '') + (wo.city || '');

	out.disks = get_disks();
	out.devices = get_devices();
	/* ★ 流量统计只认 bandix ✓ 不再合并 nlbw / conntrack 兜底数据 */
	out.bandix = get_bandix_data();
	out.traffic = get_traffic();

	/* 连接时长（WAN 的 uptime ✓）*/
	let wup = 0;
	if (wan && wan.uptime) wup = +wan.uptime;
	out.wan_uptime_s = sprintf('%d天%d小时%d分%d秒',
		(wup - (wup % 86400)) / 86400,
		((wup % 86400) - (wup % 3600)) / 3600,
		((wup % 3600) - (wup % 60)) / 60,
		wup % 60);
	/* 网络是否真的可用：接口 up + 有默认网关 + 有 DNS，三者缺一不可 */
	let why = [];
	if (wan == null) push(why, '接口未连接');
	else {
		if (length(out.wan_gw) == 0) push(why, '未获取到网关');
		if (length(dnsall) == 0) push(why, '未获取到 DNS');
	}
	out.wan_ok = (wan != null) && length(out.wan_gw) > 0 && length(dnsall) > 0;
	out.net_reason = join(' · ', why);
	out.wan_proto = wan ? (wan.proto || '') : '';
	out.dns_auto = false;
	out.wan6_on = false;
	for (let i = 0; i < length(ifs); i++) {
		if (match(ifs[i].name, /^wan6/) || (ifs[i].label == 'WAN' && length(ifs[i].v6 || '') > 0)) out.wan6_on = true;
	}

	/* 物理网口（含速率 + 归属接口 ✓）*/
	let devmap = {};
	try {
		let uc = uci_cursor();
		uc.foreach('network', 'interface', (s) => {
			let dev = s.ifname || s.device || '';
			let nm = s['.name'] || '';
			if (length(dev) == 0) return;
			for (let d in split(dev, ' ')) {
				if (length(d) == 0) continue;
				if (!devmap[d]) devmap[d] = [];
				let lab = upper(nm);
				push(devmap[d], lab);
			}
		});
	} catch (e) { }

	let ports = [];
	/* 从 /proc/net/dev 取设备名（纯文件读 ✓ 不用 popen ✗）*/
	let devlist = [];
	let nd2 = rf('/proc/net/dev') || '';
	let ndlines = split(nd2, '\n');
	for (let i = 0; i < length(ndlines); i++) {
		let m = match(ndlines[i], /^\s*([^:]+):/);
		if (m && length(m) > 1) push(devlist, trim(m[1]));
	}
	for (let i = 0; i < length(devlist); i++) {
		let d = trim(devlist[i]);
		if (length(d) == 0) continue;
		if (match(d, /^(lo|docker|br-|veth|sit|teql|dummy|dheth|wg|tun|ifb|phy|mon)/)) continue;
		if (match(d, /[.@]/)) continue;
		let carrier = trim(rf(sprintf('/sys/class/net/%s/carrier', d)) || '0');
		let oper = trim(rf(sprintf('/sys/class/net/%s/operstate', d)) || '');
		let spd = trim(rf(sprintf('/sys/class/net/%s/speed', d)) || '');
		let up = (carrier == '1') || (oper == 'up');
		let spd_s = '';
		if (up && length(spd) > 0 && +spd > 0) spd_s = sprintf('%d Mbit/s', +spd);
		let roles = devmap[d] ? join(',', devmap[d]) : '';
		push(ports, { name: d, roles: roles, up: up, speed: spd_s, oper: oper });
	}
	out.ports = ports;

	return out;
}




/* 天气：读缓存 + 后台刷新（不阻塞 ✓）*/
function get_weather() {
	let c = rf('/tmp/sakura_weather.cache') || '';
	let o = {};
	for (let ln in split(c, '\n')) {
		let p = match(ln, /^([a-z_]+)=(.*)$/);
		if (p) o[p[1]] = p[2];
	}
	let now = time();
	let stale = true;
	if (o.ts && (now - +o.ts) < 900 && length(o.city) > 0) stale = false;
	if (stale) {
		/* 通过 ubus 触发 shell 版刷新器 ✓（ucode 的 popen 被沙箱禁 ✗）*/
		try {
			let uc = ubus_connect();
			uc.call('luci.sakura_fetch', 'refresh', {});
			uc.disconnect();
		} catch (e) { }
	}
	if (length(o.city) > 0) {
		o.ok = true;
		o.age = o.ts ? (now - +o.ts) : -1;
		return o;
	}
	return { ok: false, city: '', temp: '—', desc: '正在获取…', icon: '⏳', age: 0 };
}
let cmd = '';
let cmdArg = '';
for (let i = 0; i < length(ARGV); i++) {
	let a = ARGV[i];
	if (a == 'list' || a == 'status' || a == 'weather' || a == 'set_bandix') {
		cmd = a;
		if (i + 1 < length(ARGV)) cmdArg = ARGV[i + 1];
		break;
	}
}

let result = null;
if (cmd == 'list') result = { status: { }, weather: { }, set_bandix: { on: '' } };
else if (cmd == 'status') result = get_status();
else if (cmd == 'weather') result = get_weather();
else if (cmd == 'set_bandix') {
	/* rpcd 传参：ARGV[1] 是 JSON 串（如 {"on":"1"}）✓ */
	let on = false;
	let v = null;
	try { v = json(cmdArg); } catch (e) { }
	if (v != null && v.on != null)
		on = (v.on == '1' || v.on == 1 || v.on == true || v.on == 'on' || v.on == 'true');
	else
		on = (cmdArg == '1' || cmdArg == 'on' || cmdArg == 'true');
	bandix_set_enabled(on);
	result = { ok: true, enabled: bandix_enabled() };
}
else result = { error: 'unknown method' };

if (result != null) print(sprintf('%.J', result));
