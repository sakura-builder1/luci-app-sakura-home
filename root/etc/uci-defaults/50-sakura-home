#!/bin/sh
# 樱花首页：安装 cron 任务（天气 + bandix 每设备流量采集）
CRON="/etc/crontabs/root"
[ -f "$CRON" ] || touch "$CRON"

# 天气 / 公网 IP（每分钟）
grep -q 'sakura-weather-fetch' "$CRON" 2>/dev/null || \
	echo '* * * * * /usr/bin/sakura-weather-fetch' >> "$CRON"

# bandix 每设备流量采集（每分钟）
# 未安装 bandix 时脚本会自行静默退出 ✓ 不影响系统
grep -q 'sakura-bandix-fetch' "$CRON" 2>/dev/null || \
	echo '* * * * * /usr/bin/sakura-bandix-fetch' >> "$CRON"

/etc/init.d/cron enable 2>/dev/null
/etc/init.d/cron restart 2>/dev/null
exit 0